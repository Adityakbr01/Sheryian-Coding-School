{
    "name": "yt-downloader-backend",
    "version": "1.0.0",
    "description": "Scalable YouTube Downloader Backend",
    "main": "src/server.ts",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "nodemon -r tsconfig-paths/register src/server.ts",
        "worker": "ts-node -r tsconfig-paths/register src/worker.ts",
        "build": "tsc && tsc-alias",
        "lint": "eslint src/**/*.ts"
    },
    "dependencies": {
        "bullmq": "^5.4.1",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "ffmpeg-static": "^5.3.0",
        "ffprobe-static": "^3.1.0",
        "helmet": "^7.1.0",
        "hpp": "^0.2.3",
        "ioredis": "^5.3.2",
        "node-cron": "^4.2.1",
        "socket.io": "^4.8.3",
        "uuid": "^9.0.1",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "yt-dlp-exec": "^1.0.2",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/hpp": "^0.2.7",
        "@types/node": "^20.11.19",
        "@types/node-cron": "^3.0.11",
        "@types/uuid": "^9.0.8",
        "nodemon": "^3.0.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.3"
    }
}
