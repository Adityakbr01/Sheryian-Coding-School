// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  avatar    String?
  password  String?   // nullable — OAuth users may not have a password
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  accounts  Account[]
}

// Stores one row per OAuth provider connection (a user can link multiple)
model Account {
  id                String  @id @default(cuid())
  provider          String  // "google" | "github" | "discord" etc.
  providerAccountId String  // the user's ID on that provider
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?    // unix timestamp

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ─── Chat ────────────────────────────────────────────────────────────────────

model Message {
  id        Int      @id @default(autoincrement())
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Memory (RAG / vector search) ────────────────────────────────────────────

model Memory {
  id        Int                                   @id @default(autoincrement())
  content   String
  embedding Unsupported("vector(1024)")?
  createdAt DateTime                              @default(now())
}