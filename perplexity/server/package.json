{
  "name": "server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch ./index.ts",
    "dev:cli": "bun --watch ./index.cli.ts",
    "prisma:generate": "bunx --bun prisma generate --config ./prisma.config.ts",
    "prisma:migrate": "bunx --bun prisma migrate dev --config ./prisma.config.ts",
    "prisma:push": "bunx --bun prisma db push --config ./prisma.config.ts",
    "prisma:status": "bunx --bun prisma migrate status --config ./prisma.config.ts",
    "prisma:reset": "bunx --bun prisma migrate reset --config ./prisma.config.ts",
    "prisma:studio": "bunx --bun prisma studio --config ./prisma.config.ts",
    "prisma:format": "bunx --bun prisma format --schema ./src/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.18.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@langchain/core": "^1.1.32",
    "@langchain/mistralai": "^1.0.7",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@tavily/core": "^0.7.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.2.32",
    "mongoose": "^9.3.0",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "rl": "^0.0.1",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  }
}
