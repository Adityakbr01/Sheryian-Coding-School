{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "generated/*": [
        "./generated/*"
      ],
      "prisma.config.ts": [
        "./prisma.config.ts"
      ],
      "configs/*": [
        "./src/configs/*"
      ],
      "modules/*": [
        "./src/modules/*"
      ],
      "utils/*": [
        "./src/utils/*"
      ],
      "routes/*": [
        "./src/routes/*"
      ]
    },
    "outDir": "./dist",
    "rootDir": "./",
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "src/**/*",
    "generated/**/*",
    "index.ts",
    "prisma.config.ts"
  ]
}
